<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Category for the bridge's access rights -->
        <record id="module_category_densamed" model="ir.module.category">
            <field name="name">DensaMed</field>
            <field name="description">Access to DensaMed bridge synchronisation</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_densamed_user" model="res.groups">
            <field name="name">User</field>
            <field name="category_id" ref="module_category_densamed"/>
            <field name="comment">Can view synced master data and trigger a manual sync.</field>
        </record>

        <record id="group_densamed_manager" model="res.groups">
            <field name="name">Manager</field>
            <field name="category_id" ref="module_category_densamed"/>
            <field name="implied_ids" eval="[(4, ref('group_densamed_user'))]"/>
            <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
            <field name="comment">Can change connection parameters and cron settings.</field>
        </record>

        <!-- The bridge writes with SUPERUSER via cron; regular users only read. -->
    </data>
</odoo>

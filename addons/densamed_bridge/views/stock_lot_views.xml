<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_production_lot_form_densamed" model="ir.ui.view">
        <field name="name">stock.lot.form.inherit.densamed.bridge</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <field name="expiration_date" position="after">
                <field name="days_to_expiry"/>
                <field name="densamed_id"/>
                <field name="densamed_warehouse_id"/>
                <field name="purchase_price"/>
            </field>
        </field>
    </record>

    <record id="view_production_lot_tree_densamed" model="ir.ui.view">
        <field name="name">stock.lot.tree.inherit.densamed.bridge</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.product_lot_view_tree"/>
        <field name="arch" type="xml">
            <field name="expiration_date" position="after">
                <field name="days_to_expiry" optional="show"/>
                <field name="densamed_warehouse_id" optional="hide"/>
            </field>
        </field>
    </record>

</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_warehouse_form_densamed" model="ir.ui.view">
        <field name="name">stock.warehouse.form.inherit.densamed.bridge</field>
        <field name="model">stock.warehouse</field>
        <field name="inherit_id" ref="stock.view_warehouse"/>
        <field name="arch" type="xml">
            <field name="code" position="after">
                <field name="densamed_id"/>
                <field name="branch_code"/>
            </field>
            <sheet position="inside">
                <group string="DensaMed (read-only)" invisible="not densamed_id">
                    <field name="location_description"/>
                </group>
            </sheet>
        </field>
    </record>

</odoo>

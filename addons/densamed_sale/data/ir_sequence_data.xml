<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Receipt numbering for densamed.sale (used in create() via
         ir.sequence.next_by_code('densamed.sale')). Shared across branches;
         the sale name itself carries no company scope. -->
    <data noupdate="1">
        <record id="seq_densamed_sale" model="ir.sequence">
            <field name="name">DensaMed Sale</field>
            <field name="code">densamed.sale</field>
            <field name="prefix">SALE/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>

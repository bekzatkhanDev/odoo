<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_report_densamed_receipt" model="ir.actions.report">
    <field name="name">Pharmacy Receipt</field>
    <field name="model">densamed.sale</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">densamed_sale.report_sale_receipt</field>
    <field name="report_file">densamed_sale.report_sale_receipt</field>
    <field name="binding_model_id" ref="model_densamed_sale"/>
    <field name="binding_type">report</field>
  </record>
  <template id="report_sale_receipt">
    <t t-call="web.html_container">
      <t t-foreach="docs" t-as="o">
        <t t-call="web.external_layout">
          <div class="page">
            <h2>Pharmacy receipt / Дәріхана чегі</h2>
            <p><strong>Receipt:</strong> <span t-field="o.name"/> | <strong>Date:</strong> <span t-field="o.date"/></p>
            <p><strong>Branch:</strong> <span t-field="o.company_id.name"/> | <strong>Cashier:</strong> <span t-field="o.user_id.name"/></p>
            <p t-if="o.partner_id"><strong>Customer:</strong> <span t-field="o.partner_id.name"/></p>
            <table class="table table-sm">
              <thead><tr><th>Medicine</th><th>Batch</th><th class="text-end">Qty</th><th class="text-end">Price</th><th class="text-end">Discount %</th><th class="text-end">Total</th></tr></thead>
              <tbody><tr t-foreach="o.line_ids" t-as="l"><td><span t-field="l.product_id.name"/></td><td><span t-field="l.lot_id.name"/></td><td class="text-end"><span t-field="l.quantity"/></td><td class="text-end"><span t-field="l.price_unit"/></td><td class="text-end"><span t-field="l.discount_percent"/></td><td class="text-end"><span t-field="l.subtotal" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></td></tr></tbody>
            </table>
            <h3 class="text-end">Total: <span t-field="o.amount_total" t-options="{'widget':'monetary','display_currency':o.currency_id}"/></h3>
            <p><strong>Payment:</strong> <span t-foreach="o.payment_ids" t-as="pay"><span t-field="pay.method"/>: <span t-field="pay.amount"/>; </span></p>
            <p t-if="o.state == 'returned'"><strong>RETURNED / ҚАЙТАРЫЛДЫ</strong></p>
            <p>Thank you for your purchase!</p>
          </div>
        </t>
      </t>
    </t>
  </template>
</odoo>

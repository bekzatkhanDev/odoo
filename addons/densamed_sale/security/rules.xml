<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Branch isolation: a branch is a res.company (see densamed_bridge).
             Global rules, the same pattern Odoo core uses for sale.order. -->
        <record id="rule_densamed_sale_company" model="ir.rule">
            <field name="name">DensaMed sale: own branches only</field>
            <field name="model_id" ref="model_densamed_sale"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_densamed_sale_line_company" model="ir.rule">
            <field name="name">DensaMed sale line: own branches only</field>
            <field name="model_id" ref="model_densamed_sale_line"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="rule_densamed_sale_payment_company" model="ir.rule">
            <field name="name">DensaMed sale payment: own branches only</field>
            <field name="model_id" ref="model_densamed_sale_payment"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>

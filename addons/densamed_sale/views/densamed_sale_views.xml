<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ================================ FORM ================================ -->
    <record id="view_densamed_sale_form" model="ir.ui.view">
        <field name="name">densamed.sale.form</field>
        <field name="model">densamed.sale</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Sale">
                <header>
                    <button name="action_confirm" string="Complete Sale" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_print_receipt" string="Print Receipt" type="object"
                            icon="fa-print" invisible="state not in ('completed', 'returned')"/>
                    <button name="action_return" string="Return" type="object"
                            invisible="state != 'completed'"
                            confirm="Return all items to stock and refund the payments?"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_draft" string="Set to Draft" type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_picking" type="object"
                                class="oe_stat_button" icon="fa-truck"
                                invisible="not picking_id">
                            <div class="o_stat_info">
                                <span class="o_stat_text">Delivery</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_reference" readonly="state != 'draft'"/>
                            <field name="partner_id" readonly="state != 'draft'"/>
                            <field name="warehouse_id" readonly="state != 'draft'"
                                   options="{'no_create': True, 'no_open': True}"/>
                            <field name="requires_prescription" invisible="1"/>
                            <field name="prescription_ref" readonly="state != 'draft'"
                                   required="requires_prescription"
                                   invisible="not requires_prescription"/>
                        </group>
                        <group>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="user_id"/>
                            <field name="company_id" groups="base.group_multi_company"
                                   readonly="state != 'draft'" options="{'no_create': True}"/>
                            <field name="default_payment_method"
                                   invisible="state != 'draft'"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Medicines" name="lines">
                            <field name="line_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="product_id" options="{'no_create': True}"/>
                                    <field name="requires_prescription" string="Rx"
                                           optional="show"/>
                                    <field name="lot_id" placeholder="Auto (FEFO)"
                                           options="{'no_create': True}"/>
                                    <field name="expiration_date" widget="date"
                                           optional="show"/>
                                    <field name="available_qty" optional="show"/>
                                    <field name="quantity"/>
                                    <field name="price_unit"/>
                                    <field name="discount_percent"/>
                                    <field name="discount_amount"/>
                                    <field name="subtotal" sum="Total"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="item_count"/>
                                <field name="amount_total" class="oe_subtotal_footer_separator"/>
                                <field name="amount_paid"/>
                                <field name="amount_due"/>
                            </group>
                        </page>
                        <page string="Payments" name="payments">
                            <field name="payment_ids" readonly="state != 'draft'">
                                <tree editable="bottom">
                                    <field name="date"/>
                                    <field name="method"/>
                                    <field name="amount"/>
                                    <field name="state"/>
                                    <field name="currency_id" column_invisible="1"/>
                                </tree>
                            </field>
                            <p class="text-muted">
                                Leave empty to pay the full amount with the chosen payment
                                method; add several rows for split payments (they must add
                                up to the total).
                            </p>
                        </page>
                        <page string="Profit" name="profit" groups="densamed_sale.group_densamed_sale_manager">
                            <group><field name="margin_total"/></group>
                            <field name="line_ids" readonly="1">
                                <tree create="0" delete="0">
                                    <field name="product_id"/>
                                    <field name="quantity"/>
                                    <field name="cost_unit"/>
                                    <field name="subtotal"/>
                                    <field name="margin_amount" sum="Gross Profit"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Stock" name="stock" invisible="not picking_id">
                            <group>
                                <field name="picking_id"/>
                                <field name="return_picking_id" invisible="not return_picking_id"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="note" placeholder="Internal notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ================================ TREE ================================ -->
    <record id="view_densamed_sale_tree" model="ir.ui.view">
        <field name="name">densamed.sale.tree</field>
        <field name="model">densamed.sale</field>
        <field name="arch" type="xml">
            <tree string="Pharmacy Sales" sample="1"
                  decoration-info="state == 'draft'"
                  decoration-muted="state in ('cancelled', 'returned')">
                <field name="name"/>
                <field name="date"/>
                <field name="partner_id" optional="show"/>
                <field name="user_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
                <field name="warehouse_id" optional="hide"/>
                <field name="item_count" optional="show" sum="Units"/>
                <field name="amount_total" sum="Total"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'completed'"
                       decoration-warning="state == 'returned'"
                       decoration-danger="state == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <!-- ================================ SEARCH ============================== -->
    <record id="view_densamed_sale_search" model="ir.ui.view">
        <field name="name">densamed.sale.search</field>
        <field name="model">densamed.sale</field>
        <field name="arch" type="xml">
            <search string="Search Sales">
                <field name="name" string="Receipt"/>
                <field name="partner_id"/>
                <field name="user_id"/>
                <field name="prescription_ref"/>
                <field name="customer_reference"/>
                <field name="line_ids" string="Medicine" filter_domain="[('line_ids.product_id', 'ilike', self)]"/>
                <filter string="Today" name="today"
                        domain="[('date', '&gt;=', context_today().strftime('%Y-%m-%d 00:00:00'))]"/>
                <separator/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Completed" name="completed" domain="[('state', '=', 'completed')]"/>
                <filter string="Returned" name="returned" domain="[('state', '=', 'returned')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter string="My sales" name="my_sales" domain="[('user_id', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Cashier" name="group_user" context="{'group_by': 'user_id'}"/>
                    <filter string="Branch" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Day" name="group_day" context="{'group_by': 'date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- ================================ ACTION ============================== -->
    <record id="action_densamed_sale" model="ir.actions.act_window">
        <field name="name">Sales (Сату)</field>
        <field name="res_model">densamed.sale</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_densamed_sale_search"/>
        <field name="context">{'search_default_today': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create the first pharmacy sale</p>
            <p>Add medicines, the batch is picked automatically (earliest expiry first),
               then complete the sale to issue the stock and register the payment.</p>
        </field>
    </record>

</odoo>

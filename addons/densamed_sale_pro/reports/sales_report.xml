<odoo><record id="action_report_dashboard" model="ir.actions.report"><field name="name">Sales Performance PDF</field><field name="model">densamed.sales.dashboard</field><field name="report_type">qweb-pdf</field><field name="report_name">densamed_sale_pro.report_dashboard_document</field><field name="report_file">densamed_sale_pro.report_dashboard_document</field></record><template id="report_dashboard_document"><t t-call="web.html_container"><t t-foreach="docs" t-as="o"><t t-call="web.external_layout"><div class="page"><h2>DensaMed — Sales Performance</h2><p><span t-field="o.company_id.name"/> | <span t-field="o.date_from"/> — <span t-field="o.date_to"/></p><table class="table table-sm"><tr><th>Completed Sales</th><td><span t-field="o.sale_count"/></td></tr><tr><th>Revenue</th><td><span t-field="o.revenue"/></td></tr><tr><th>Gross Profit (estimated)</th><td><span t-field="o.gross_profit"/></td></tr><tr><th>Units</th><td><span t-field="o.units"/></td></tr><tr><th>Average Ticket</th><td><span t-field="o.average_ticket"/></td></tr><tr><th>Returned Orders</th><td><span t-field="o.returns_count"/></td></tr></table></div></t></t></t></template></odoo>
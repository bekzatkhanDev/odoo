<odoo>
<record id="sale_form_pro" model="ir.ui.view"><field name="name">densamed.sale.form.pro</field><field name="model">densamed.sale</field><field name="inherit_id" ref="densamed_sale.view_densamed_sale_form"/><field name="arch" type="xml"><xpath expr="//field[@name='customer_reference']" position="after"><field name="promo_code" readonly="state != 'draft'"/><field name="promo_id" readonly="1"/><button name="action_apply_promo" type="object" string="Apply Promo" class="btn-secondary" invisible="state != 'draft'"/><field name="promo_discount" readonly="1"/><field name="loyalty_points_earned" readonly="1"/></xpath></field></record>
<record id="partner_form_pro" model="ir.ui.view"><field name="name">res.partner.form.pharmacy</field><field name="model">res.partner</field><field name="inherit_id" ref="base.view_partner_form"/><field name="arch" type="xml"><xpath expr="//sheet/notebook" position="inside"><page string="Pharmacy CRM" groups="densamed_sale.group_densamed_sale_manager"><group><field name="pharmacy_segment"/><field name="pharmacy_sale_count"/><field name="pharmacy_spend"/><field name="pharmacy_loyalty_points"/></group><button name="action_pharmacy_sales" type="object" string="Purchase History" class="btn-primary"/></page></xpath></field></record>
<record id="view_promo_tree" model="ir.ui.view"><field name="name">densamed.promo.tree</field><field name="model">densamed.sale.promo</field><field name="arch" type="xml"><tree decoration-muted="not active"><field name="name"/><field name="code"/><field name="active" column_invisible="1"/><field name="discount_percent"/><field name="min_amount"/><field name="automatic"/><field name="used_count"/><field name="usage_limit"/><field name="end_date"/><field name="company_id" groups="base.group_multi_company"/></tree></field></record>
<record id="view_promo_form" model="ir.ui.view"><field name="name">densamed.promo.form</field><field name="model">densamed.sale.promo</field><field name="arch" type="xml"><form><sheet><group><group><field name="name"/><field name="code"/><field name="company_id"/><field name="active"/><field name="automatic"/></group><group><field name="discount_percent"/><field name="min_amount"/><field name="currency_id" invisible="1"/><field name="start_date"/><field name="end_date"/><field name="usage_limit"/><field name="used_count"/></group></group></sheet></form></field></record>
<record id="action_promo" model="ir.actions.act_window"><field name="name">Promotions &amp; Codes</field><field name="res_model">densamed.sale.promo</field><field name="view_mode">tree,form</field></record>
<record id="view_alert_tree" model="ir.ui.view"><field name="name">densamed.alert.tree</field><field name="model">densamed.stock.alert</field><field name="arch" type="xml"><tree decoration-danger="is_low"><field name="product_id"/><field name="warehouse_id"/><field name="min_qty"/><field name="available_qty"/><field name="is_low"/><field name="company_id" groups="base.group_multi_company"/></tree></field></record>
<record id="view_alert_form" model="ir.ui.view"><field name="name">densamed.alert.form</field><field name="model">densamed.stock.alert</field><field name="arch" type="xml"><form><sheet><group><field name="product_id"/><field name="company_id"/><field name="warehouse_id"/><field name="min_qty"/><field name="available_qty"/><field name="is_low"/></group></sheet></form></field></record>
<record id="action_alert" model="ir.actions.act_window"><field name="name">Stock Alerts</field><field name="res_model">densamed.stock.alert</field><field name="view_mode">tree,form</field></record>
<record id="view_dashboard_form" model="ir.ui.view"><field name="name">densamed.dashboard.form</field><field name="model">densamed.sales.dashboard</field><field name="arch" type="xml"><form string="Smart Sales Dashboard" create="0"><header><button name="action_sales" type="object" string="Sales Charts &amp; Pivot" class="btn-primary"/><button name="action_lines" type="object" string="Top Medicines"/><button name="action_print" type="object" string="PDF Report"/></header><sheet><h1>Sales Performance</h1><group><group><field name="company_id"/><field name="date_from"/></group><group><field name="date_to"/><field name="currency_id" invisible="1"/></group></group><group><group string="Revenue"><field name="revenue"/><field name="gross_profit"/><field name="average_ticket"/></group><group string="Orders"><field name="sale_count"/><field name="units"/><field name="returns_count"/></group></group><div class="alert alert-info" role="alert">Change dates and save to refresh metrics. Use Sales Charts &amp; Pivot for interactive reporting.</div></sheet></form></field></record>
<record id="action_dashboard" model="ir.actions.act_window"><field name="name">Smart Dashboard</field><field name="res_model">densamed.sales.dashboard</field><field name="view_mode">form</field><field name="target">current</field></record>
<record id="view_forecast_form" model="ir.ui.view"><field name="name">densamed.forecast.form</field><field name="model">densamed.sales.forecast</field><field name="arch" type="xml"><form string="Sales Forecast" create="0"><header><button name="action_top_products" type="object" string="Popular Medicines" class="btn-primary"/></header><sheet><h1>Demand Forecast</h1><group><field name="company_id"/><field name="lookback_days"/><field name="horizon_days"/><field name="currency_id" invisible="1"/></group><group><field name="historical_revenue"/><field name="daily_average"/><field name="forecast_revenue"/></group><div class="alert alert-warning" role="alert">Statistical baseline: historical daily average × forecast days. This is not a trained AI model; results are estimates, not guaranteed sales.</div></sheet></form></field></record>
<record id="action_forecast" model="ir.actions.act_window"><field name="name">Sales Forecast</field><field name="res_model">densamed.sales.forecast</field><field name="view_mode">form</field></record>
<record id="action_customers" model="ir.actions.act_window"><field name="name">Pharmacy Customers</field><field name="res_model">res.partner</field><field name="view_mode">kanban,tree,form</field><field name="domain">[('customer_rank','>',0)]</field></record>
<menuitem id="menu_dashboard" name="Smart Dashboard" parent="densamed_sale.menu_densamed_sale_root" action="action_dashboard" sequence="2" groups="densamed_sale.group_densamed_sale_manager"/>
<menuitem id="menu_customers" name="Customers &amp; CRM" parent="densamed_sale.menu_densamed_sale_root" action="action_customers" sequence="12" groups="densamed_sale.group_densamed_sale_manager"/>
<menuitem id="menu_forecast" name="Sales Forecast" parent="densamed_sale.menu_densamed_sale_root" action="action_forecast" sequence="22" groups="densamed_sale.group_densamed_sale_manager"/>
<menuitem id="menu_alert" name="Stock Alerts" parent="densamed_sale.menu_densamed_sale_root" action="action_alert" sequence="24" groups="densamed_sale.group_densamed_sale_manager"/>
<menuitem id="menu_promo" name="Promotions" parent="densamed_sale.menu_densamed_sale_root" action="action_promo" sequence="26" groups="densamed_sale.group_densamed_sale_manager"/>
</odoo>